COMPOSE_PROJECT_NAME=harbor-bootc

IMAGE_REPO=8gears.container-registry.com/8gcr-dev/
IMAGE_SUFFIX=
HARBOR_TAG=bootc

# High HTTP port to avoid collisions with dev stacks and other registries.
BIND_ADDR=0.0.0.0
PORT_HTTP=18085
EXT_ENDPOINT=http://hetzner-bootc.tail6c5ea9.ts.net:18085
CSRF_KEY=bootc-csrf-key-change-me-0000000
CSRF_TRUSTED_ORIGINS=localhost:18085,127.0.0.1:18085,100.100.156.26:18085,hetzner-bootc.tail6c5ea9.ts.net:18085

HARBOR_ADMIN_PASSWORD=Harbor12345
CORE_SECRET=bootc-core-secret-change-me
JOBSERVICE_SECRET=bootc-jobservice-secret-change-me
DB_PASSWORD=bootc-db-password-change-me

DB_USER=postgres
DB_NAME=registry
DB_SSLMODE=disable
LOG_LEVEL=info
CACHE_ENABLED=true
WITH_TRIVY=true
WITH_GRYPE=true
WITH_SNYK=false
DEFAULT_SCANNER=Grype
SCANNER_TRIVY_SEVERITY=UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL

POSTGRES_VERSION=16
VALKEY_VERSION=8

# Leave empty unless the registry service needs explicit basic-auth credentials.
REGISTRY_CREDENTIAL_USERNAME=
REGISTRY_CREDENTIAL_PASSWORD=
