{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-header": "This PR prepares the next Helm chart release on this release branch, from conventional commits scoped to deploy/chart.",
  "pull-request-title-pattern": "chore: release harbor chart ${version}",
  "label": "chart-release: pending",
  "release-label": "chart-release: tagged",
  "versioning": "always-bump-patch",
  "include-v-in-tag": true,
  "tag-separator": "-",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Harbor Releases"
    },
    {
      "type": "ci",
      "section": "CI/CD",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "chart",
      "section": "Chart Changes"
    }
  ],
  "packages": {
    "deploy/chart": {
      "release-type": "helm",
      "package-name": "harbor",
      "component": "chart",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "release-as": "2.2.0"
    }
  },
  "last-release-sha": "238dcf6f7a614470cb05f2fe0ef6a1e44b03e463"
}
