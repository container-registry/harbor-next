#!/usr/bin/env ys-0

# check-env.ys — drift check between docker-compose.yaml's ${VAR}
# references and the documented variables in .env.example files.
#
# Usage (from deploy/compose):
#   ys check-env.ys docker-compose.yaml .env.example example/local/.env.example
#
# Verdicts:
#   ERROR — variable referenced WITHOUT a default (${VAR} or ${VAR:?...})
#           and documented in no .env.example: compose interpolates an
#           empty string / aborts, and nobody can discover the knob
#   WARN  — variable referenced with a default (${VAR:-...}) but not
#           documented: works, but the knob is invisible
#   WARN  — .env.example key never referenced by the compose file (stale)
#
# Commented keys (# KEY=...) in .env.example count as documented — that
# is the convention for optional overrides.
# Exit 1 on ERROR only.

problems =: atom([])

default-compose =: 'docker-compose.yaml'
default-env1 =: '.env.example'
default-env2 =: 'example/local/.env.example'

defn main(compose-file=default-compose env1=default-env1 env2=default-env2):
  compose =: compose-file:read:yaml/load
  refs =: compose:collect-strings:extract-refs
  documented =: +[env1 env2].map(env-keys).flatten():distinct:V

  ref-names =: refs.map(\(_.name)):distinct:sort:V
  with-default =: refs.filter(\(_.has-default)).map(\(_.name)):distinct:V

  each name ref-names:
    known =: name.in?(documented)
    has-default =: name.in?(with-default)
    cond:
      known: nil
      has-default:
        add-problem 'WARN' name:
          'referenced with a default in docker-compose.yaml but documented
           in no .env.example — the knob is invisible to operators'
      else:
        add-problem 'ERROR' name:
          'referenced WITHOUT a default in docker-compose.yaml and
           documented in no .env.example — interpolates to empty (or
           aborts) and nobody can discover it'

  each key documented:sort:V:
    when not(key.in?(ref-names)) && (key != 'COMPOSE_PROJECT_NAME'):
      add-problem 'WARN' key:
        'documented in .env.example but never referenced by
         docker-compose.yaml — stale documentation'

  ps =: problems:deref
  n-refs =: ref-names.#
  n-doc =: documented.#
  if ps:seq:
    then:
      warn: "check-env: $compose-file vs .env.example drift:"
      each p ps:
        warn: "  [$(p.level)] $(p.what)"
        warn: "      $(p.note)"
      errors =: ps.filter(\(_.level == 'ERROR')).#
      when errors > 0:
        exit: 1
    else:
      say: "check-env: $n-refs referenced vars, $n-doc documented keys
            — in sync"

# All string scalars anywhere in a YAML structure.
defn collect-strings(v):
  cond:
    string?(v): +[v]
    map?(v): v:vals.map(collect-strings):flatten:V
    sequential?(v): v.map(collect-strings):flatten:V
    else: +[]

var-rx =: qr('\$\{([A-Za-z_][A-Za-z0-9_]*)((:?[-?])([^}]*))?\}')
default-ops =:: ['-', ':-']

# Return a vector of {name, has-default} maps.
defn extract-refs(strings):
  matches =: strings.map(\(re-seq(var-rx _))):flatten1.filter(some?)
  matches: .map(ref-of):V

defn flatten1(colls):
  reduce: \(concat(_1 (_2 || [])):V) [] colls

defn ref-of(m):
  =>::
    name:: m.1
    has-default:: m.3.in?(default-ops)

env-key-rx =: qr('^#?\s*([A-Z_][A-Z0-9_]*)=')

defn env-keys(file):
  file: .read().lines()
    .map(\(second(re-find(env-key-rx _))))
    .filter(some?):distinct:V

defn add-problem(level what note):
  swap problems conj::
    level:: level
    what:: what
    note:: note
