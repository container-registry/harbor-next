{
  "uid": "harbor-security-hub",
  "title": "Harbor Security Hub",
  "tags": [
    "harbor",
    "security",
    "cve",
    "harbor-security-hub"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "description": "Registry-wide vulnerability overview from the Harbor Security Hub API.",
  "graphTooltip": 0,
  "timepicker": {
    "hidden": true
  },
  "links": [
    {
      "title": "Security Hub",
      "type": "dashboards",
      "tags": [
        "harbor-security-hub"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {},
        "options": [],
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "multi": false,
        "includeAll": false,
        "allowCustomValue": false,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Critical findings",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "Findings summed over every scanned artifact; one CVE in N artifacts counts N times.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/security/summary",
          "root_selector": "",
          "columns": [],
          "url_options": {
            "method": "GET",
            "data": ""
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^critical_cnt$/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-red"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "High findings",
      "datasource": {
