            "fixedColor": "blue"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Scan coverage",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "Artifacts with a default-scanner report / all artifact rows. The denominator includes signatures, SBOMs and index children, so this is a lower bound.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/security/summary",
          "root_selector": "",
          "columns": [],
          "url_options": {
            "method": "GET",
            "data": ""
          }
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "coverage",
            "replaceFields": true,
            "binary": {
              "left": "scanned_cnt",
              "operator": "/",
              "right": "total_artifact"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top 5 dangerous CVEs",
      "description": "Click a CVE to see every repository it affects.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/security/summary?with_dangerous_cve=true",
          "root_selector": "dangerous_cves",
          "columns": [
            {
              "selector": "cve_id",
              "text": "CVE",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "Severity",
              "type": "string"
            },
            {
              "selector": "cvss_score_v3",
              "text": "CVSS",
              "type": "number"
            },
            {
              "selector": "package",
              "text": "Package",
              "type": "string"
            },
            {
              "selector": "version",
              "text": "Version",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "GET",
            "data": ""
          }
        }
      ],
      "transformations": [],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "High": {
                        "color": "red",
                        "index": 1
                      },
                      "Medium": {
                        "color": "orange",
                        "index": 2
                      },
                      "Low": {
                        "color": "yellow",
                        "index": 3
                      },
                      "Unknown": {
                        "color": "gray",
                        "index": 4
                      },
                      "None": {
                        "color": "green",
                        "index": 5
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "project_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Repository"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Where is this CVE?",
                    "url": "/d/harbor-security-hub-cve?var-datasource=${datasource}&var-cve=${__value.raw}"
                  },
                  {
                    "title": "Open in NVD",
                    "url": "https://nvd.nist.gov/vuln/detail/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 5 dangerous artifacts",
      "description": "Click a repository to open its project.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${datasource}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/security/summary?with_dangerous_artifact=true",
          "root_selector": "dangerous_artifacts",
          "columns": [
            {
              "selector": "project_id",
              "text": "project_id",
              "type": "number"
            },
            {
              "selector": "repository_name",
              "text": "Repository",
              "type": "string"
            },
            {
              "selector": "digest",
              "text": "Digest",
              "type": "string"
            },
            {
              "selector": "critical_cnt",
              "text": "Critical",
              "type": "number"
            },
            {
              "selector": "high_cnt",
              "text": "High",
              "type": "number"
            },
            {
              "selector": "medium_cnt",
              "text": "Medium",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET",
            "data": ""
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Repository": 0,
              "Critical": 1,
              "High": 2,
              "Medium": 3,
              "Digest": 4,
              "project_id": 5
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "High": {
                        "color": "red",
                        "index": 1
                      },
                      "Medium": {
                        "color": "orange",
                        "index": 2
                      },
                      "Low": {
                        "color": "yellow",
                        "index": 3
                      },
                      "Unknown": {
                        "color": "gray",
                        "index": 4
                      },
                      "None": {
                        "color": "green",
                        "index": 5
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "project_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Repository"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CVE"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Repository"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open project",
                    "url": "/d/harbor-security-hub-project?var-datasource=${datasource}&var-project=${__data.fields.project_id}&var-severity=Critical"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Drill down:** [Where is a CVE?](/d/harbor-security-hub-cve?var-datasource=${datasource}) \u00b7 [What is in a project?](/d/harbor-security-hub-project?var-datasource=${datasource}) \u2014 or click a CVE or repository above. Data is live from the Harbor Security Hub API; the time range has no effect."
      }
    }
  ]
}
