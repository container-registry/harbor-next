                      number: 80
                path: /api/
                pathType: Prefix
              - backend:
                  service:
                    name: harbor-core
                    port:
                      number: 80
                path: /service/
                pathType: Prefix
              - backend:
                  service:
                    name: harbor-core
                    port:
                      number: 80
                path: /v2/
                pathType: Prefix
