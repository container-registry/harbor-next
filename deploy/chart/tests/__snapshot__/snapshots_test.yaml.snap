  6: |
    apiVersion: v1
    data:
      config.yml: |
        job_loggers:
        - level: INFO
          name: FILE
          settings:
            base_dir: /var/log/jobs
          sweeper:
            duration: 14
            settings:
              work_dir: /var/log/jobs
        loggers:
        - level: INFO
          name: STD_OUTPUT
        port: 8080
        protocol: http
        reaper:
          max_dangling_hours: 168
          max_update_hours: 24
        worker_pool:
          backend: redis
          redis_pool:
            idle_timeout_second: 3600
            namespace: harbor_job_service_namespace
            redis_url: redis://valkey:6379/1
          workers: 4
    kind: ConfigMap
    metadata:
