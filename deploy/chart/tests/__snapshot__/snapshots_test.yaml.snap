          enableTLS: false
          pool:
            idletimeout: 60s
            maxactive: 500
            maxidle: 100
          readtimeout: 10s
          writetimeout: 10s
        storage:
          cache:
            layerinfo: redis
          delete:
            enabled: true
          filesystem:
            rootdirectory: /storage
