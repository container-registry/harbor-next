ARG JAVA_VERSION=21
FROM eclipse-temurin:${JAVA_VERSION}-jdk-jammy

ARG MAVEN_VERSION=3.9.9

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates coreutils curl git openssl tar unzip zip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
    | tar -xz -C /opt \
    && ln -s "/opt/apache-maven-${MAVEN_VERSION}/bin/mvn" /usr/local/bin/mvn

WORKDIR /work
COPY run-compat.sh /usr/local/bin/run-maven-compat
RUN chmod +x /usr/local/bin/run-maven-compat

ENTRYPOINT ["/usr/local/bin/run-maven-compat"]
CMD ["all"]
